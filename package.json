{
  "name": "harbor-lens",
  "version": "0.1.0-alpha.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.10.0"
  },
  "scripts": {
    "dev": "vite --configLoader runner --host 127.0.0.1",
    "build": "node tools/check-toolchain.cjs && vite build --configLoader runner && node tools/notices.cjs && node tools/check-artifact.mjs",
    "test": "vitest run --configLoader runner",
    "test:coverage": "vitest run --configLoader runner --coverage",
    "test:browser": "playwright test",
    "test:tooling": "node --test test/tooling/*.test.mjs",
    "test:contracts": "go -C test/contracts test -count=1 ./...",
    "compose:up": "node tools/compose-local.mjs up",
    "compose:down": "node tools/compose-local.mjs down",
    "format:check": "prettier --check src test tools index.html *.js *.mjs *.json compose.yaml .github/workflows/*.yml",
    "format": "prettier --write src test tools index.html *.js *.mjs *.json compose.yaml .github/workflows/*.yml"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.12",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "packageManager": "yarn@4.18.0",
  "dependencies": {
    "@joint/core": "4.3.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "i18next": "23.16.8",
    "lucide-react": "1.32.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "15.7.4",
    "react-is": "19.2.8",
    "react-router-dom": "7.18.2",
    "recharts": "3.8.0",
    "tailwind-merge": "3.6.0"
  }
}
